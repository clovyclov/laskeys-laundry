---
import Layout from '../layouts/Layout.astro';
import PhotoGallery from '../components/PhotoGallery.astro';

const faqs = [
  {
    q: 'Do your machines take credit cards or quarters?',
    a: 'Our self-service washers and dryers accept both credit cards and quarters directly at the machine! We also have dual bill-to-quarter change machines and an on-site ATM for your convenience.',
  },
  {
    q: 'Can I wash giant king-size comforters and heavy blankets?',
    a: 'Yes! We have mega 60lb and giant 80lb commercial washers specifically built for king comforters, sleeping bags, and heavy blankets that won’t fit in home machines.',
  },
  {
    q: 'How long does a wash and dry cycle take?',
    a: 'Our high-efficiency washers complete a full cycle in about 25–30 minutes. Thanks to high-speed water extraction, our dryers finish most loads in 15–20 minutes! You can be done in under 45 minutes.',
  },
  {
    q: 'How does Drop-off Wash & Fold work and what are the hours?',
    a: 'Drop off your dirty laundry at our counter between 6:00 AM and 7:00 PM daily. Please note drop-off service is Cash Only (an on-site ATM is available). Standard next-day is $1.50/lb, and same-day express / bedding is $2.00/lb.',
  },
  {
    q: 'Is pickup and delivery available?',
    a: 'Door-to-door pickup and delivery is launching soon across Toledo! Check our Pickup & Delivery page to verify your neighborhood and join our early access waitlist.',
  },
  {
    q: 'Is there someone on staff to help me?',
    a: 'Yes! Friendly attendants are on site during peak hours to assist with machines, change, wash & fold drop-offs, and questions.',
  },
];
---

<Layout title="Hours, Location & Contact - Laskey's Laundry Toledo" activeTab="location">
  <section class="page-header">
    <div class="container">
      <span class="pill-badge">VISIT OUR STORE</span>
      <h1 class="header-title">HOURS, LOCATION & DIRECTIONS</h1>
      <p class="header-desc">
        Located right on Laskey and Secor. Open 7 days a week with bright seating, free Wi-Fi, credit card & coin machines, and on-site ATM.
      </p>
    </div>
  </section>

  <!-- Location Info Grid -->
  <section class="info-section">
    <div class="container">
      <div class="info-grid">
        <!-- Card 1: Open Status & Hours -->
        <div class="info-card card-retro">
          <div class="status-indicator">
            <span class="status-dot"></span>
            <span id="live-status-text" class="status-text">OPEN NOW • Closes 10:00 PM</span>
          </div>

          <h2 class="card-heading">OPERATING HOURS</h2>

          <div class="hours-table">
            <div class="hours-item">
              <span>Laundromat (Self-Service)</span>
              <strong>6:00 AM – 10:00 PM</strong>
            </div>
            <div class="hours-item">
              <span>Wash & Fold Drop-Off</span>
              <strong>6:00 AM – 7:00 PM</strong>
            </div>
            <div class="hours-item">
              <span>Drop-Off Payment</span>
              <strong style="color: var(--brand-red);">Cash Only (ATM On Site)</strong>
            </div>
            <div class="hours-item">
              <span>Open 7 Days</span>
              <strong>365 Days / Year</strong>
            </div>
          </div>

          <p class="last-wash-note">* Last wash load starts 1 hour before store closing time (9:00 PM).</p>
        </div>

        <!-- Card 2: Store Address & Phone -->
        <div class="info-card card-retro">
          <div class="pin-badge">STORE LOCATION</div>
          <h2 class="card-heading">ADDRESS & CONTACT</h2>

          <div class="contact-details">
            <div class="detail-row">
              <span class="detail-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
              </span>
              <div>
                <strong>Laskey's Laundry</strong>
                <p>3330 W Laskey Rd<br />Toledo, OH 43623</p>
              </div>
            </div>

            <div class="detail-row">
              <span class="detail-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </span>
              <div>
                <strong>Phone Number</strong>
                <p><a href="tel:4192140778" class="phone-link">(419) 214-0778</a></p>
              </div>
            </div>

            <div class="detail-row">
              <span class="detail-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              </span>
              <div>
                <strong>Parking & Access</strong>
                <p>Free spacious parking lot right in front of the doors. Easy cart access.</p>
              </div>
            </div>
          </div>

          <a
            href="https://www.google.com/maps?cid=250511804809595549"
            target="_blank"
            rel="noopener noreferrer"
            id="location-card-get-directions"
            class="btn-retro-red btn-get-directions"
            data-gtm-category="directions"
            data-gtm-action="click"
            data-gtm-label="location_card_directions"
            style="width: 100%; text-align: center; margin-top: 20px; transform: none;"
          >
            OPEN IN GOOGLE MAPS
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Map Placeholder / Directions -->
  <section class="map-section">
    <div class="container">
      <div class="map-card card-retro">
        <div class="map-placeholder font-bebas">
          <span>3330 W LASKEY RD · TOLEDO, OH 43623</span>
          <a
            href="https://www.google.com/maps?cid=250511804809595549"
            target="_blank"
            rel="noopener noreferrer"
            id="location-map-get-directions"
            class="btn-retro-secondary btn-get-directions"
            data-gtm-category="directions"
            data-gtm-action="click"
            data-gtm-label="location_map_directions"
            style="margin-top: 16px; transform: none;"
          >
            GET TURN-BY-TURN DIRECTIONS
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq-section">
    <div class="container" style="max-width: 850px;">
      <div class="section-title text-center">
        <h2>FREQUENTLY ASKED QUESTIONS</h2>
      </div>

      <div class="faq-list">
        {faqs.map((faq, i) => (
          <details class="faq-item card-retro" open={i === 0}>
            <summary class="faq-question">
              <span>{faq.q}</span>
              <span class="faq-toggle">+</span>
            </summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Facility Gallery -->
  <PhotoGallery />
</Layout>

<script>
  // Live Store Status Script
  document.addEventListener('DOMContentLoaded', () => {
    const statusText = document.getElementById('live-status-text');
    if (!statusText) return;

    const now = new Date();
    const hour = now.getHours();

    // 6:00 AM - 10:00 PM every day (7 days a week)
    const isOpen = hour >= 6 && hour < 22;
    const closeTime = '10:00 PM';

    if (isOpen) {
      statusText.textContent = `OPEN NOW • Closes at ${closeTime}`;
    } else {
      statusText.textContent = `CLOSED NOW • Opens at 6:00 AM`;
      const dot = document.querySelector('.status-dot') as HTMLElement;
      if (dot) dot.style.background = '#ef4444';
    }
  });
</script>

<style>
  .page-header {
    background: var(--bg-cream-dark);
    padding: 60px 0;
    text-align: center;
    border-bottom: 3px solid var(--border-dark);
  }

  .header-title {
    font-size: 3.8rem;
    margin-top: 12px;
    margin-bottom: 12px;
  }

  .header-desc {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 650px;
    margin: 0 auto;
  }

  .text-center {
    text-align: center;
  }

  .info-section {
    padding: 60px 0 30px;
  }

  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .info-card {
    padding: 32px;
    background: #ffffff;
    display: flex;
    flex-direction: column;
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #dcfce7;
    border: 1px solid #86efac;
    padding: 6px 12px;
    font-weight: 700;
    font-size: 0.9rem;
    color: #14532d;
    align-self: flex-start;
    margin-bottom: 16px;
  }

  .status-dot {
    width: 10px;
    height: 10px;
    border-radius: 100%;
    background: #22c55e;
  }

  .pin-badge {
    display: inline-block;
    background: var(--brand-red);
    color: white;
    font-family: 'Bebas Neue', sans-serif;
    padding: 2px 10px;
    align-self: flex-start;
    margin-bottom: 16px;
    font-size: 0.95rem;
  }

  .card-heading {
    font-size: 2.2rem;
    margin-bottom: 20px;
  }

  .hours-table {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 20px;
  }

  .hours-item {
    display: flex;
    justify-content: space-between;
    font-size: 1.05rem;
    padding-bottom: 8px;
    border-bottom: 1px dashed var(--border-dark);
  }

  .hours-item span {
    color: var(--text-muted);
  }

  .last-wash-note {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-style: italic;
    margin-top: auto;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .detail-row {
    display: flex;
    gap: 14px;
    font-size: 0.95rem;
  }

  .detail-icon {
    font-size: 1.5rem;
  }

  .phone-link {
    color: var(--brand-red);
    font-weight: 700;
  }

  .map-section {
    padding: 0 0 60px;
  }

  .map-card {
    background: var(--text-dark);
    color: #ffffff;
    padding: 60px 24px;
    text-align: center;
  }

  .map-placeholder {
    font-size: 2rem;
    letter-spacing: 1px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .faq-section {
    padding: 60px 0;
    background: var(--bg-cream-dark);
    border-top: 3px solid var(--border-dark);
    border-bottom: 3px solid var(--border-dark);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 36px;
  }

  .faq-item {
    background: #ffffff;
    padding: 16px 24px;
  }

  .faq-question {
    font-weight: 700;
    font-size: 1.1rem;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-answer {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px dashed var(--border-dark);
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .info-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
