---
import Layout from '../layouts/Layout.astro';
import ZipChecker from '../components/ZipChecker.astro';
---

<Layout title="Laundry Pickup & Delivery (Coming Soon) - Laskey's Laundry Toledo" activeTab="pickup-and-delivery">
  <section class="page-header">
    <div class="container">
      <span class="pill-badge" style="background: var(--brand-red); color: #fff;">LAUNCHING SOON IN TOLEDO</span>
      <h1 class="header-title">LAUNDRY PICKUP & DELIVERY (COMING SOON)</h1>
      <p class="header-desc">
        We are preparing our door-to-door laundry pickup & delivery service across Toledo! Check your neighborhood ZIP code below and join our early access waitlist to be first in line when we launch.
      </p>
    </div>
  </section>

  <!-- Zip Checker & Coverage -->
  <section class="zip-section">
    <div class="container" style="max-width: 800px;">
      <ZipChecker />
    </div>
  </section>

  <!-- Pickup Request Form Section -->
  <section class="form-section" id="pickup-form">
    <div class="container" style="max-width: 760px;">
      <div class="form-card card-retro">
        <div class="form-header text-center">
          <span class="pill-badge">EARLY ACCESS WAITLIST</span>
          <h2 class="form-title">JOIN THE DELIVERY LAUNCH LIST</h2>
          <p class="form-desc">Be the first to know when our Toledo delivery van starts servicing your street. Plus, get free delivery on your first order!</p>
        </div>

        <form id="schedule-form" class="request-form">
          <div class="form-row">
            <div class="form-group">
              <label for="full-name">Full Name *</label>
              <input type="text" id="full-name" name="full_name" required placeholder="e.g. Sarah Miller" class="form-input" />
            </div>

            <div class="form-group">
              <label for="phone-num">Phone Number *</label>
              <input type="tel" id="phone-num" name="phone" required placeholder="(419) 555-0199" class="form-input" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group flex-2">
              <label for="street-address">Street Address (Optional)</label>
              <input type="text" id="street-address" name="street_address" placeholder="e.g. 1234 Secor Rd" class="form-input" />
            </div>

            <div class="form-group flex-1">
              <label for="zip-code">ZIP Code *</label>
              <input type="text" id="zip-code" name="zip_code" required placeholder="43623" maxlength="5" class="form-input" />
            </div>
          </div>

          <!-- Preferred First Pickup Date (hidden until pickup & delivery service officially launches) -->
          <div class="form-group flex-1" id="pickup-date-group" style="display: none;">
            <label for="preferred-date">Preferred First Pickup Date</label>
            <div class="date-input-wrapper">
              <input type="date" id="preferred-date" name="preferred_date" class="form-input" disabled />
              <span class="date-calendar-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
              </span>
            </div>
          </div>

          <div class="form-group">
            <label for="detergent-pref">Preferred Detergent</label>
            <select id="detergent-pref" name="detergent" class="form-input">
              <option value="Tide Original">Tide Original</option>
              <option value="Gain Original Scent">Gain Original Scent</option>
              <option value="Free & Clear Hypoallergenic (Fragrance-Free)">Free & Clear Hypoallergenic (Fragrance-Free)</option>
            </select>
          </div>

          <div class="form-group">
            <label for="special-notes">Notes or Questions</label>
            <textarea id="special-notes" name="notes" rows="3" placeholder="e.g. Interested in weekly family pickup or commercial linen service..." class="form-input"></textarea>
          </div>

          <div id="form-error" class="hidden" style="background: rgba(220, 38, 38, 0.15); border: 1px solid var(--brand-red); color: #fff; padding: 12px 16px; border-radius: 6px; margin-bottom: 15px; font-size: 0.95rem;">
            Sorry, there was an issue submitting your request. Please try again or call us at (419) 214-0778.
          </div>

          <button type="submit" id="submit-btn" class="btn-retro-red" style="width: 100%; transform: none; font-size: 1.3rem; margin-top: 10px;">
            JOIN DELIVERY WAITLIST
          </button>
        </form>

        <div id="form-success" class="success-banner hidden card-dark">
          <div class="success-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--brand-red)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <h3 class="font-bebas" style="font-size: 2rem; color: #ffffff;">YOU'RE ON THE WAITLIST!</h3>
          <p style="color: #d1d5db; margin-top: 6px;">
            Thank you! We will notify you via text at <span id="confirm-phone" style="color: var(--brand-red); font-weight: bold;"></span> as soon as our Toledo delivery service launches.
          </p>
          <p style="font-size: 0.85rem; color: #9ca3af; margin-top: 12px;">In the meantime, feel free to visit us for drop-off wash & fold (6am-7pm daily) at 3330 W Laskey Rd.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const WEBHOOK_URL = 'https://services.leadconnectorhq.com/hooks/HvAYChUFuCk6krO0Qu5L/webhook-trigger/b0b534b9-a473-4c51-aa7c-9c05bd7de1da';

  const VALID_ZIPS = [
    '43613', '43612', '43623', '43614', '43606',
    '43615', '43607', '43608', '43609', '43611',
    '43620', '43604', '43560', '43551'
  ];

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('schedule-form') as HTMLFormElement | null;
    const successBanner = document.getElementById('form-success');
    const formError = document.getElementById('form-error');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const fullNameInput = document.getElementById('full-name') as HTMLInputElement | null;
    const phoneInput = document.getElementById('phone-num') as HTMLInputElement | null;
    const addressInput = document.getElementById('street-address') as HTMLInputElement | null;
    const zipInput = document.getElementById('zip-code') as HTMLInputElement | null;
    const preferredDateInput = document.getElementById('preferred-date') as HTMLInputElement | null;
    const detergentSelect = document.getElementById('detergent-pref') as HTMLSelectElement | null;
    const notesTextarea = document.getElementById('special-notes') as HTMLTextAreaElement | null;
    const confirmPhone = document.getElementById('confirm-phone');

    // Set default pickup date to tomorrow and set minimum allowed date to tomorrow
    if (preferredDateInput) {
      const tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);
      const minDateStr = tomorrow.toISOString().split('T')[0];
      preferredDateInput.min = minDateStr;
      preferredDateInput.value = minDateStr;

      preferredDateInput.addEventListener('click', () => {
        try {
          if ('showPicker' in HTMLInputElement.prototype) {
            preferredDateInput.showPicker();
          }
        } catch (_) {}
      });
    }

    if (form && successBanner) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (formError) formError.classList.add('hidden');

        const originalBtnText = submitBtn ? submitBtn.textContent : 'JOIN DELIVERY WAITLIST';
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'SUBMITTING...';
        }

        const fullName = fullNameInput?.value.trim() || '';
        const nameParts = fullName.split(/\s+/);
        const firstName = nameParts[0] || '';
        const lastName = nameParts.slice(1).join(' ') || '';
        const phone = phoneInput?.value.trim() || '';
        const address = addressInput?.value.trim() || '';
        const zip = zipInput?.value.trim() || '';
        const preferredDate = (preferredDateInput && !preferredDateInput.disabled) ? preferredDateInput.value : '';
        const detergent = detergentSelect?.value || 'Tide Original';
        const notes = notesTextarea?.value.trim() || '';

        // Check if ZIP code is within Toledo primary delivery launch zone
        const isInArea = VALID_ZIPS.includes(zip);
        const areaStatus = isInArea ? 'in_area' : 'out_of_area';

        const payload = {
          full_name: fullName,
          name: fullName,
          first_name: firstName,
          last_name: lastName,
          phone: phone,
          address1: address,
          street_address: address,
          city: 'Toledo',
          state: 'OH',
          postal_code: zip,
          zip_code: zip,
          area_status: areaStatus,
          is_in_area: isInArea,
          coverage: isInArea ? 'In Launch Zone' : 'Outside Launch Zone',
          preferred_date: preferredDate,
          detergent: detergent,
          notes: notes,
          source: "Laskey's Laundry Pickup & Delivery Waitlist",
          form_name: 'pickup_and_delivery_waitlist',
          submitted_at: new Date().toISOString()
        };

        try {
          const response = await fetch(WEBHOOK_URL, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
          });

          if (!response.ok) {
            throw new Error(`Server returned ${response.status}`);
          }

          if (confirmPhone && phone) {
            confirmPhone.textContent = phone;
          }

          // Push GTM dataLayer conversion event
          if (typeof window !== 'undefined') {
            (window as any).dataLayer = (window as any).dataLayer || [];
            (window as any).dataLayer.push({
              event: 'waitlist_submission',
              form_name: 'pickup_and_delivery_waitlist',
              zip_code: zip,
              area_status: areaStatus,
              is_in_area: isInArea
            });
          }

          // Redirect to Thank You page with details
          const redirectUrl = new URL('/thank-you', window.location.origin);
          if (phone) redirectUrl.searchParams.set('phone', phone);
          if (firstName) redirectUrl.searchParams.set('name', firstName);
          if (zip) redirectUrl.searchParams.set('zip', zip);
          redirectUrl.searchParams.set('area_status', areaStatus);
          window.location.href = redirectUrl.toString();
        } catch (err) {
          console.error('Waitlist submission error:', err);
          if (formError) {
            formError.classList.remove('hidden');
          } else {
            alert('There was an issue submitting your request. Please try again or call us at (419) 214-0778.');
          }
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = originalBtnText;
          }
        }
      });
    }
  });
</script>

<style>
  .page-header {
    background: var(--bg-cream-dark);
    padding: 60px 0;
    text-align: center;
    border-bottom: 3px solid var(--border-dark);
  }

  .header-title {
    font-size: 3.8rem;
    margin-top: 12px;
    margin-bottom: 12px;
  }

  .header-desc {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 650px;
    margin: 0 auto;
  }

  .text-center {
    text-align: center;
  }

  .zip-section {
    padding: 60px 0 30px;
  }

  .form-section {
    padding: 30px 0 60px;
  }

  .form-card {
    padding: 40px;
    background: #ffffff;
  }

  .form-title {
    font-size: 2.4rem;
    margin-top: 10px;
    margin-bottom: 8px;
  }

  .form-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 32px;
  }

  .request-form.hidden {
    display: none;
  }

  .form-row {
    display: flex;
    gap: 20px;
    margin-bottom: 16px;
  }

  .form-group {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 16px;
  }

  .flex-2 { flex: 2; }
  .flex-1 { flex: 1; }

  .form-group label {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--text-dark);
  }

  .form-input {
    border: 2px solid var(--border-dark);
    padding: 12px 14px;
    font-size: 1rem;
    font-family: inherit;
    background: var(--bg-cream);
    width: 100%;
    box-sizing: border-box;
  }

  .date-input-wrapper {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }

  .date-input-wrapper input[type="date"] {
    padding-right: 44px;
    cursor: pointer;
    position: relative;
  }

  .date-calendar-icon {
    position: absolute;
    right: 14px;
    pointer-events: none;
    color: var(--text-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  input[type="date"]::-webkit-calendar-picker-indicator {
    opacity: 0;
    cursor: pointer;
    position: absolute;
    right: 0;
    top: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
  }

  input[type="date"].form-input {
    min-height: 48px;
    color: var(--text-dark);
  }

  .form-input:focus {
    outline: none;
    background: #ffffff;
    border-color: var(--brand-red);
  }

  .success-banner {
    padding: 32px;
    text-align: center;
  }

  .success-banner.hidden {
    display: none;
  }

  .success-icon {
    font-size: 3rem;
    margin-bottom: 10px;
  }

  @media (max-width: 600px) {
    .form-row {
      flex-direction: column;
      gap: 0;
    }
  }
</style>
