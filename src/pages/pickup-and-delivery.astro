---
import Layout from '../layouts/Layout.astro';
import ZipChecker from '../components/ZipChecker.astro';
---

<Layout title="Laundry Pickup & Delivery (Coming Soon) - Laskey's Laundry Toledo" activeTab="pickup-and-delivery">
  <section class="page-header">
    <div class="container">
      <span class="pill-badge" style="background: var(--brand-red); color: #fff;">LAUNCHING SOON IN TOLEDO</span>
      <h1 class="header-title">LAUNDRY PICKUP & DELIVERY (COMING SOON)</h1>
      <p class="header-desc">
        We are preparing our door-to-door laundry pickup & delivery service across Toledo! Check your neighborhood ZIP code below and join our early access waitlist to be first in line when we launch.
      </p>
    </div>
  </section>

  <!-- Zip Checker & Coverage -->
  <section class="zip-section">
    <div class="container" style="max-width: 800px;">
      <ZipChecker />
    </div>
  </section>

  <!-- Pickup Request Form Section -->
  <section class="form-section" id="pickup-form">
    <div class="container" style="max-width: 760px;">
      <div class="form-card card-retro">
        <div class="form-header text-center">
          <span class="pill-badge">EARLY ACCESS WAITLIST</span>
          <h2 class="form-title">JOIN THE DELIVERY LAUNCH LIST</h2>
          <p class="form-desc">Be the first to know when our Toledo delivery van starts servicing your street. Plus, get free delivery on your first order!</p>
        </div>

        <form id="schedule-form" class="request-form">
          <div class="form-row">
            <div class="form-group">
              <label for="full-name">Full Name *</label>
              <input type="text" id="full-name" required placeholder="e.g. Sarah Miller" class="form-input" />
            </div>

            <div class="form-group">
              <label for="phone-num">Phone Number *</label>
              <input type="tel" id="phone-num" required placeholder="(419) 555-0199" class="form-input" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group flex-2">
              <label for="street-address">Street Address (Optional)</label>
              <input type="text" id="street-address" placeholder="e.g. 1234 Secor Rd" class="form-input" />
            </div>

            <div class="form-group flex-1">
              <label for="zip-code">ZIP Code *</label>
              <input type="text" id="zip-code" required placeholder="43623" maxlength="5" class="form-input" />
            </div>
          </div>

          <div class="form-group">
            <label for="detergent-pref">Preferred Detergent</label>
            <select id="detergent-pref" class="form-input">
              <option value="tide">Tide Original</option>
              <option value="gain">Gain Original Scent</option>
              <option value="free-clear">Free & Clear Hypoallergenic (Fragrance-Free)</option>
            </select>
          </div>

          <div class="form-group">
            <label for="special-notes">Notes or Questions</label>
            <textarea id="special-notes" rows="3" placeholder="e.g. Interested in weekly family pickup or commercial linen service..." class="form-input"></textarea>
          </div>

          <button type="submit" class="btn-retro-red" style="width: 100%; transform: none; font-size: 1.3rem; margin-top: 10px;">
            JOIN DELIVERY WAITLIST
          </button>
        </form>

        <div id="form-success" class="success-banner hidden card-dark">
          <div class="success-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--brand-red)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <h3 class="font-bebas" style="font-size: 2rem; color: #ffffff;">YOU'RE ON THE WAITLIST!</h3>
          <p style="color: #d1d5db; margin-top: 6px;">
            Thank you! We will notify you via text at <span id="confirm-phone" style="color: var(--brand-red); font-weight: bold;"></span> as soon as our Toledo delivery service launches.
          </p>
          <p style="font-size: 0.85rem; color: #9ca3af; margin-top: 12px;">In the meantime, feel free to visit us for drop-off wash & fold (6am-7pm daily) at 3330 W Laskey Rd.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('schedule-form') as HTMLFormElement;
    const successBanner = document.getElementById('form-success');
    const phoneInput = document.getElementById('phone-num') as HTMLInputElement;
    const confirmPhone = document.getElementById('confirm-phone');

    // Set default date to tomorrow
    const dateInput = document.getElementById('pickup-date') as HTMLInputElement;
    if (dateInput) {
      const tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);
      dateInput.value = tomorrow.toISOString().split('T')[0];
    }

    if (form && successBanner) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (confirmPhone && phoneInput) {
          confirmPhone.textContent = phoneInput.value || 'your phone number';
        }
        form.classList.add('hidden');
        successBanner.classList.remove('hidden');
        successBanner.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    }
  });
</script>

<style>
  .page-header {
    background: var(--bg-cream-dark);
    padding: 60px 0;
    text-align: center;
    border-bottom: 3px solid var(--border-dark);
  }

  .header-title {
    font-size: 3.8rem;
    margin-top: 12px;
    margin-bottom: 12px;
  }

  .header-desc {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 650px;
    margin: 0 auto;
  }

  .text-center {
    text-align: center;
  }

  .zip-section {
    padding: 60px 0 30px;
  }

  .form-section {
    padding: 30px 0 60px;
  }

  .form-card {
    padding: 40px;
    background: #ffffff;
  }

  .form-title {
    font-size: 2.4rem;
    margin-top: 10px;
    margin-bottom: 8px;
  }

  .form-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 32px;
  }

  .request-form.hidden {
    display: none;
  }

  .form-row {
    display: flex;
    gap: 20px;
    margin-bottom: 16px;
  }

  .form-group {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 16px;
  }

  .flex-2 { flex: 2; }
  .flex-1 { flex: 1; }

  .form-group label {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--text-dark);
  }

  .form-input {
    border: 2px solid var(--border-dark);
    padding: 12px 14px;
    font-size: 1rem;
    font-family: inherit;
    background: var(--bg-cream);
    width: 100%;
  }

  .form-input:focus {
    outline: none;
    background: #ffffff;
    border-color: var(--brand-red);
  }

  .success-banner {
    padding: 32px;
    text-align: center;
  }

  .success-banner.hidden {
    display: none;
  }

  .success-icon {
    font-size: 3rem;
    margin-bottom: 10px;
  }

  @media (max-width: 600px) {
    .form-row {
      flex-direction: column;
      gap: 0;
    }
  }
</style>
