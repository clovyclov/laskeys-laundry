---
import Layout from '../layouts/Layout.astro';
import PhotoGallery from '../components/PhotoGallery.astro';

const faqs = [
  {
    q: 'How much does it cost to wash a comforter?',
    a: 'We charge our standard flat bedding rate of $2.00 per pound for all drop-off comforters, duvets, and quilts. You only pay for the exact weight of your item.',
  },
  {
    q: 'Do you have machines large enough for King-size down comforters?',
    a: 'Yes. We use 60lb and 80lb commercial washers that give large down comforters and thick duvets ample room to soak, tumble, and rinse out detergent completely.',
  },
  {
    q: 'How do you dry comforters without ruining the filling or feathers?',
    a: 'Our attendants dry heavy bedding on controlled low-to-medium heat with regular checks to ensure down feathers and synthetic fills fluff evenly without scorching or clumping.',
  },
  {
    q: 'Can I do it myself in the laundromat instead of dropping it off?',
    a: 'Yes. Our self-service laundromat has giant 60lb and 80lb coin and credit card washers ready for customer use 7 days a week from 7:00 AM to 9:00 PM (last wash at 8:00 PM).',
  },
  {
    q: 'What is the drop-off turnaround time for bedding?',
    a: 'Next-day turnaround is standard. Same-day express is available if you drop off by 10:00 AM. Drop-off payment is Cash Only (an on-site ATM is available).',
  },
];
---

<Layout
  title="Wash & Fold for Comforters & Heavy Bedding - Laskey's Laundry Toledo"
  description="Professional wash and fold for King and Queen comforters, duvets, quilts, and heavy blankets in Toledo, OH. Giant 80lb washers, gentle low-heat drying, and $2.00/lb pricing."
  activeTab="services"
>
  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <span class="pill-badge">BEDDING & HEAVY LINENS</span>
      <h1 class="header-title">WASH & FOLD FOR COMFORTERS & BEDDING</h1>
      <p class="header-desc">
        Drop off your bulky king-size comforters, down duvets, handmade quilts, and heavy blankets at 3330 W Laskey Rd in Toledo. We wash them in giant 80lb machines and dry them on gentle low heat.
      </p>
      <div class="header-payment-tag">
        CASH ONLY FOR DROP-OFF · ON-SITE ATM AVAILABLE · 7:00 AM – 7:00 PM DAILY
      </div>
    </div>
  </section>

  <!-- Left/Right Split Section 1: Machine Size & Deep Clean -->
  <section class="split-section">
    <div class="container">
      <div class="split-row">
        <!-- Text Left -->
        <div class="split-text-col">
          <span class="section-tag">COMMERCIAL CAPACITY</span>
          <h2 class="split-heading">GIANT 80LB WASHERS FOR HEAVY BEDDING</h2>
          <p class="split-paragraph">
            Most home washers cannot handle thick king-size comforters or weighted blankets. When crammed into small residential drums, water cannot circulate, leaving detergent residue, dust mites, and odors trapped in the core.
          </p>
          <p class="split-paragraph">
            We wash bedding in commercial Huebsch machines ranging up to 80 pounds of capacity. The spacious wash drum gives heavy fabrics room to tumble freely through fresh water, ensuring deep cleaning and thorough rinsing.
          </p>
          <ul class="split-checklist">
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>King, Queen, Full & Twin Down Comforters</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Handmade Quilts & Bulky Winter Blankets</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Washable Woolens, Rugs & Mattress Covers</span>
            </li>
          </ul>
        </div>

        <!-- Image Right (Polaroid Frame) -->
        <div class="split-image-col">
          <div class="polaroid-frame" style="transform: rotate(1.5deg);">
            <div class="polaroid-tape"></div>
            <div class="img-wrapper">
              <img src="/images/IMG_7082.webp" alt="80lb commercial washer drums for comforters at Laskey's Laundry" loading="lazy" />
            </div>
            <div class="polaroid-caption font-bebas">80LB COMFORTER MEGA WASHERS</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Left/Right Split Section 2: Low Heat Drying & Pricing -->
  <section class="split-section bg-alt">
    <div class="container">
      <div class="split-row reverse">
        <!-- Text Right -->
        <div class="split-text-col">
          <span class="section-tag">CONTROLLED DRYING</span>
          <h2 class="split-heading">GENTLE LOW-HEAT DRYING FOR DOWN & FILLS</h2>
          <p class="split-paragraph">
            High heat can singe delicate synthetic fills and clump natural down feathers. Our attendants monitor your comforter through dedicated low-to-medium heat dry cycles, rotating the item so it dries evenly throughout without burning.
          </p>
          <div class="price-callout-box card-retro">
            <div class="callout-header">
              <span class="font-bebas callout-price">$2.00 / lb</span>
              <span class="callout-label">Flat Per-Pound Rate</span>
            </div>
            <p class="callout-desc">
              No guesswork flat fees. Drop off your comforter, we weigh it on our digital scale, and you pay strictly for what it weighs.
            </p>
          </div>
          <div class="split-btn-wrap">
            <a
              href="https://maps.google.com/?q=3330+W+Laskey+Rd+Toledo+OH+43623"
              target="_blank"
              rel="noopener noreferrer"
              id="comforter-get-directions"
              class="btn-retro-red btn-get-directions"
              data-gtm-category="directions"
              data-gtm-action="click"
              data-gtm-label="comforter_page_directions"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
              GET DIRECTIONS TO DROP OFF
            </a>
          </div>
        </div>

        <!-- Image Left (Polaroid Frame) -->
        <div class="split-image-col">
          <div class="polaroid-frame" style="transform: rotate(-1.5deg);">
            <div class="polaroid-tape"></div>
            <div class="img-wrapper">
              <img src="/images/IMG_7081.webp" alt="High-capacity express dryers for comforters at Laskey's Laundry" loading="lazy" />
            </div>
            <div class="polaroid-caption font-bebas">HIGH-HEAT & LOW-HEAT EXPRESS DRYERS</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Photo Gallery -->
  <PhotoGallery />

  <!-- FAQs Section -->
  <section class="faq-section">
    <div class="container">
      <div class="section-title text-center">
        <span class="pill-badge">HAVE QUESTIONS?</span>
        <h2>COMFORTER & BEDDING FAQS</h2>
        <p class="sub-text">Common questions about dropping off blankets, quilts, and large down bedding.</p>
      </div>

      <div class="faq-grid">
        {faqs.map((faq) => (
          <div class="faq-card card-retro">
            <h3 class="faq-question font-bebas">{faq.q}</h3>
            <p class="faq-answer">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA Banner -->
  <section class="bottom-cta-section">
    <div class="container text-center">
      <div class="cta-box card-retro">
        <h2 class="cta-heading font-bebas">DROP OFF YOUR COMFORTER TODAY</h2>
        <p class="cta-text">
          Located right on Laskey and Secor at 3330 W Laskey Rd, Toledo, OH. Drop-off counter open 7:00 AM to 7:00 PM daily. Cash only (ATM on site).
        </p>
        <div class="cta-btn-row">
          <a
            href="https://maps.google.com/?q=3330+W+Laskey+Rd+Toledo+OH+43623"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-retro-red btn-get-directions"
            data-gtm-category="directions"
            data-gtm-action="click"
            data-gtm-label="comforter_footer_directions"
          >
            GET DIRECTIONS
          </a>
          <a href="tel:4192140778" class="btn-retro-secondary">
            CALL US: (419) 214-0778
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background: var(--bg-cream-dark);
    padding: 60px 0 40px;
    text-align: center;
    border-bottom: 3px solid var(--border-dark);
  }

  .header-title {
    font-size: 3.5rem;
    margin-top: 12px;
    margin-bottom: 12px;
  }

  .header-desc {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 750px;
    margin: 0 auto 20px;
  }

  .header-payment-tag {
    display: inline-block;
    background: rgba(220, 38, 38, 0.1);
    color: var(--brand-red);
    font-weight: 800;
    font-size: 0.9rem;
    letter-spacing: 0.5px;
    padding: 6px 16px;
    border: 2px solid var(--brand-red);
  }

  /* Left/Right Split Sections */
  .split-section {
    padding: 70px 0;
  }

  .split-section.bg-alt {
    background: var(--bg-cream-dark);
    border-top: 3px solid var(--border-dark);
    border-bottom: 3px solid var(--border-dark);
  }

  .split-row {
    display: flex;
    align-items: center;
    gap: 48px;
  }

  .split-row.reverse {
    flex-direction: row-reverse;
  }

  .split-text-col {
    flex: 1.2;
  }

  .split-image-col {
    flex: 0.9;
  }

  .section-tag {
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: var(--brand-blue);
    display: block;
    margin-bottom: 8px;
  }

  .split-heading {
    font-size: 2.6rem;
    line-height: 1.1;
    margin-bottom: 16px;
  }

  .split-paragraph {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .split-checklist {
    list-style: none;
    padding: 0;
    margin: 20px 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .split-checklist li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 0.95rem;
  }

  /* Price Callout */
  .price-callout-box {
    background: #ffffff;
    padding: 20px;
    margin: 24px 0;
  }

  .callout-header {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 6px;
  }

  .callout-price {
    font-size: 2.4rem;
    color: var(--brand-red);
  }

  .callout-label {
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-dark);
  }

  .callout-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin: 0;
  }

  .split-btn-wrap {
    margin-top: 24px;
  }

  /* Polaroid Image Wrapper */
  .img-wrapper {
    height: 320px;
    overflow: hidden;
    background: #e5e5e5;
  }

  .img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .polaroid-caption {
    text-align: center;
    margin-top: 14px;
    font-size: 1.1rem;
    letter-spacing: 1.5px;
    color: var(--text-dark);
  }

  /* FAQs Section */
  .faq-section {
    padding: 60px 0;
    background: #ffffff;
  }

  .section-title h2 {
    font-size: 3rem;
    margin-top: 10px;
    margin-bottom: 8px;
  }

  .sub-text {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto 40px;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .faq-card {
    background: var(--bg-cream-dark);
    padding: 28px;
  }

  .faq-question {
    font-size: 1.4rem;
    letter-spacing: 1px;
    margin-bottom: 10px;
    color: var(--text-dark);
  }

  .faq-answer {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* Bottom CTA */
  .bottom-cta-section {
    padding: 60px 0;
    background: var(--bg-cream-dark);
  }

  .cta-box {
    background: #ffffff;
    padding: 48px;
    max-width: 850px;
    margin: 0 auto;
  }

  .cta-heading {
    font-size: 3rem;
    margin-bottom: 12px;
  }

  .cta-text {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto 30px;
  }

  .cta-btn-row {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  @media (max-width: 860px) {
    .split-row,
    .split-row.reverse {
      flex-direction: column;
      gap: 32px;
    }

    .faq-grid {
      grid-template-columns: 1fr;
    }

    .header-title {
      font-size: 2.8rem;
    }

    .split-heading {
      font-size: 2.2rem;
    }

    .cta-box {
      padding: 28px 20px;
    }
  }
</style>
