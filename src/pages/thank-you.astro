---
import Layout from '../layouts/Layout.astro';
---

<Layout title="You're on the Waitlist! - Laskey's Laundry Toledo" activeTab="pickup-and-delivery">
  <section class="thank-you-header">
    <div class="container">
      <span class="pill-badge" style="background: var(--brand-red); color: #fff;">CONFIRMATION · EARLY ACCESS</span>
      <h1 class="header-title">YOU'RE ON THE WAITLIST!</h1>
      <p class="header-desc">
        Thank you for joining the Laskey's Laundry delivery launch list. We have saved your spot and will reach out the moment our Toledo delivery van hits your street.
      </p>
    </div>
  </section>

  <section class="thank-you-content">
    <div class="container" style="max-width: 820px;">
      <div class="confirmation-card card-retro">
        <div class="badge-icon-wrap">
          <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="var(--brand-red)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
        </div>

        <div id="area-status-badge" class="pill-badge hidden" style="color: #fff; margin-bottom: 14px; display: inline-block;"></div>

        <h2 class="confirm-title font-bebas">SPOT RESERVED FOR PICKUP & DELIVERY</h2>
        <p class="confirm-text">
          <span id="personalized-greeting">We'll text you</span> at <span id="confirm-phone" class="highlight-phone">your phone number</span> as soon as routes open in your neighborhood.
        </p>

        <div class="perks-grid">
          <div class="perk-item">
            <div class="perk-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="3" width="15" height="13" rx="2"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
            </div>
            <div>
              <h3>FREE First Delivery</h3>
              <p>Your early access status guarantees free delivery on your very first laundry order.</p>
            </div>
          </div>

          <div class="perk-item">
            <div class="perk-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              </svg>
            </div>
            <div>
              <h3>First in Line Notification</h3>
              <p>You'll receive an SMS notification before the public rollout so you can choose your preferred pickup schedule.</p>
            </div>
          </div>

          <div class="perk-item">
            <div class="perk-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
            </div>
            <div>
              <h3>Need Laundry Today?</h3>
              <p>Visit us at 3330 W Laskey Rd! Drop off your clothes with our attendants (6am–7pm daily) for same-day or next-day wash & fold.</p>
            </div>
          </div>
        </div>

        <div class="cta-actions">
          <a
            href="https://www.google.com/maps?cid=250511804809595549"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-retro-red btn-get-directions"
            id="thankyou-get-directions"
            data-gtm-label="thankyou_directions_click"
            style="transform: none; text-decoration: none;"
          >
            GET DIRECTIONS TO LASKEY'S
          </a>
          <a
            href="/wash-and-fold"
            class="btn-secondary"
            style="text-decoration: none;"
          >
            EXPLORE DROP-OFF WASH & FOLD
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Check URL parameters for personalized confirmation
    const urlParams = new URLSearchParams(window.location.search);
    const phone = urlParams.get('phone');
    const name = urlParams.get('name');

    const phoneEl = document.getElementById('confirm-phone');
    const greetingEl = document.getElementById('personalized-greeting');
    const areaBadge = document.getElementById('area-status-badge');

    const areaStatus = urlParams.get('area_status');
    const zip = urlParams.get('zip');

    if (phone && phoneEl) {
      phoneEl.textContent = phone;
    }

    if (name && greetingEl) {
      greetingEl.textContent = `Thanks ${name}! We'll text you`;
    }

    if (areaBadge && areaStatus) {
      if (areaStatus === 'in_area') {
        areaBadge.textContent = zip ? `ZIP ${zip}: In Primary Launch Zone` : 'In Primary Launch Zone';
        areaBadge.style.background = '#15803d';
        areaBadge.style.border = '2px solid #166534';
      } else {
        areaBadge.textContent = zip ? `ZIP ${zip}: Expansion Route Waitlist` : 'Expansion Route Waitlist';
        areaBadge.style.background = '#b45309';
        areaBadge.style.border = '2px solid #92400e';
      }
      areaBadge.classList.remove('hidden');
    }

    // Push GTM thank you event
    if (typeof window !== 'undefined') {
      (window as any).dataLayer = (window as any).dataLayer || [];
      (window as any).dataLayer.push({
        event: 'thank_you_page_view',
        page: 'delivery_waitlist_thank_you',
        area_status: areaStatus || 'unknown',
        zip_code: zip || ''
      });
    }
  });
</script>

<style>
  .thank-you-header {
    background: var(--bg-cream-dark);
    padding: 60px 0 40px;
    text-align: center;
    border-bottom: 3px solid var(--border-dark);
  }

  .header-title {
    font-size: 3.8rem;
    margin-top: 12px;
    margin-bottom: 12px;
  }

  .header-desc {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 620px;
    margin: 0 auto;
  }

  .thank-you-content {
    padding: 50px 0 80px;
  }

  .confirmation-card {
    padding: 45px;
    text-align: center;
    background: #ffffff;
  }

  .badge-icon-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 16px;
  }

  .confirm-title {
    font-size: 2.4rem;
    letter-spacing: 0.5px;
    color: var(--text-dark);
    margin-bottom: 12px;
  }

  .confirm-text {
    font-size: 1.15rem;
    color: var(--text-dark);
    max-width: 580px;
    margin: 0 auto 36px;
    line-height: 1.5;
  }

  .highlight-phone {
    font-weight: 700;
    color: var(--brand-red);
  }

  .perks-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    text-align: left;
    margin-bottom: 40px;
  }

  .perk-item {
    display: flex;
    gap: 18px;
    padding: 20px;
    background: var(--bg-cream);
    border: 2px solid var(--border-dark);
    box-shadow: 3px 3px 0px var(--border-dark);
  }

  .perk-icon {
    display: flex;
    align-items: flex-start;
    padding-top: 2px;
    color: var(--brand-red);
    flex-shrink: 0;
  }

  .perk-item h3 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.35rem;
    letter-spacing: 0.5px;
    margin: 0 0 4px;
    color: var(--text-dark);
  }

  .perk-item p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .cta-actions .btn-retro-red {
    width: 100%;
    max-width: 380px;
    font-size: 1.2rem;
    padding: 14px 24px;
    text-align: center;
  }

  .btn-secondary {
    display: inline-block;
    width: 100%;
    max-width: 380px;
    background: #ffffff;
    color: var(--text-dark);
    border: 2px solid var(--border-dark);
    padding: 12px 24px;
    font-weight: 700;
    font-size: 1.05rem;
    text-align: center;
    box-shadow: 3px 3px 0px var(--border-dark);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .btn-secondary:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px var(--border-dark);
  }

  @media (max-width: 640px) {
    .confirmation-card {
      padding: 24px 18px;
    }

    .header-title {
      font-size: 2.8rem;
    }

    .confirm-title {
      font-size: 2rem;
    }
  }
</style>
