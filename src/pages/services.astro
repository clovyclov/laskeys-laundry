---
import Layout from '../layouts/Layout.astro';
import PhotoGallery from '../components/PhotoGallery.astro';

// Service Cards Array - Easily expandable for new SEO pages!
const serviceCards = [
  {
    id: 'wash-and-fold',
    icon: 'basket',
    iconColor: '#e07a5f',
    title: 'Drop-Off Wash & Fold',
    desc: 'Our premier attendant service. Drop off your everyday clothes, towels, and household linens for professional sorting, washing, drying, and crisp folding.',
    bullets: [
      'Next-Day Service ($1.50 / lb)',
      'Same-Day Express ($2.00 / lb)',
      'Tide, Gain, or Hypoallergenic Free & Clear',
      'Drop-Off Daily 7:00 AM – 7:00 PM (Cash Only)',
    ],
    btnText: 'EXPLORE WASH & FOLD',
    btnHref: '/wash-and-fold',
    isDark: false,
  },
  {
    id: 'comforter-bedding',
    icon: 'bedding',
    iconColor: '#3b82f6',
    title: 'Comforters & Heavy Bedding',
    desc: 'Specialized deep-cleaning and gentle low-heat drying for king-size down comforters, duvets, quilts, and heavy weighted blankets.',
    bullets: [
      'King, Queen & Full Comforters',
      'Low-Heat Drying Protects Down & Fills',
      'Flat Per-Pound Rate ($2.00 / lb)',
      'Deep Sanitization & Dust Mite Removal',
    ],
    btnText: 'VIEW BEDDING DETAILS',
    btnHref: '/wash-and-fold#pricing',
    isDark: false,
  },
  {
    id: 'suits-delicates',
    icon: 'suit',
    iconColor: '#8b5cf6',
    title: 'Suits & Delicate Garments',
    desc: 'Customized gentle cycles and delicate handling for washable suits, blazers, dress shirts, delicate blouses, and sensitive fabrics.',
    bullets: [
      'Cold-Water Gentle Wash Cycles',
      'Low-Spin Fabric & Seam Protection',
      'Air-Dry / Low-Tumble Options',
      'Attendants Carefully Inspect Care Labels',
    ],
    btnText: 'SEE DELICATE CARE',
    btnHref: '/wash-and-fold',
    isDark: false,
  },
  {
    id: 'self-service',
    icon: 'washer',
    iconColor: '#10b981',
    title: 'Self-Service Coin & Card',
    desc: 'Toledo’s cleanest, brightest laundromat with commercial stainless steel Huebsch washers and high-heat express dryers.',
    bullets: [
      '20lb to 80lb Mega Comforter Washers',
      'Credit Cards & Quarters on Machines',
      'Dual Bill Changers & On-Site ATM',
      'Express 20-Min Dryers Cut Wait Times',
    ],
    btnText: 'VIEW MACHINES & AMENITIES',
    btnHref: '/self-service',
    isDark: false,
  },
  {
    id: 'commercial-airbnb',
    icon: 'building',
    iconColor: '#f59e0b',
    title: 'Commercial & Airbnb Linens',
    desc: 'Dependable towel and linen laundry service tailored for Toledo short-term rental hosts (Airbnb/VRBO), hair salons, spas, and gyms.',
    bullets: [
      'Fast Turnover Scheduling for Rentals',
      'Sanitized Sheets, Duvets & Bath Linens',
      'Flexible Drop-Off Schedules',
      'Detailed Invoices & Receipts for Taxes',
    ],
    btnText: 'COMMERCIAL SERVICES',
    btnHref: '/location',
    isDark: false,
  },
  {
    id: 'sports-activewear',
    icon: 'fitness',
    iconColor: '#ec4899',
    title: 'Athletic & Sports Gear',
    desc: 'Odor-eliminating laundry care designed to break down sweat oils, turf grime, and bacteria from synthetic workout clothes and sports uniforms.',
    bullets: [
      'Odor-Neutralizing Deep Wash',
      'Safe on Spandex, Lycra & Synthetics',
      'Sports Uniforms & Team Jerseys',
      'Crisply Folded & Sealed in Wrap',
    ],
    btnText: 'EXPLORE ATHLETIC CARE',
    btnHref: '/wash-and-fold',
    isDark: false,
  },
  {
    id: 'pickup-delivery',
    icon: 'delivery',
    iconColor: '#06b6d4',
    title: 'Toledo Pickup & Delivery',
    desc: 'Door-to-door laundry service launching soon! We pick up dirty bags from your porch and deliver clean, fresh folded laundry back to your door.',
    bullets: [
      'Contactless Porch Pickup & Delivery',
      'FREE Delivery on Orders Over 30 lbs',
      'Serving Greater Toledo Launch Routes',
      'Early Access Waitlist Open Now',
    ],
    btnText: 'CHECK ZIP & JOIN WAITLIST',
    btnHref: '/pickup-and-delivery',
    isDark: false,
  },
  {
    id: 'custom-schedule',
    icon: 'phone',
    iconColor: '#f97316',
    title: 'Need A Custom Laundry Plan?',
    desc: 'Have recurring high-volume laundry, specialized fabric questions, or unique commercial requirements? Our Toledo team is here to help.',
    bullets: [
      'Custom Turnaround Schedules',
      'On-Site Attendants 7 Days a Week',
      'Direct Phone Support & Advice',
      'Convenient Drop-Off at Laskey & Secor',
    ],
    btnText: 'GIVE US A CALL (419) 214-0778',
    btnHref: 'tel:4192140778',
    isDark: true,
  },
];
---

<Layout
  title="All Laundry Services & Solutions - Laskey's Laundry Toledo OH"
  description="Explore all laundry services at Laskey's Laundry in Toledo, OH. Drop-off wash & fold ($1.50-$2.00/lb), king comforters, washable suits, 20-80lb self-service machines, commercial linens, and upcoming delivery."
  activeTab="services"
>
  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <span class="pill-badge">TOLEDO LAUNDRY SOLUTIONS</span>
      <h1 class="header-title">OUR LAUNDRY SERVICES</h1>
      <p class="header-desc">
        Explore our complete range of full-service drop-off wash & fold, specialty garment care, commercial linen services, and self-service laundromat amenities.
      </p>
    </div>
  </section>

  <!-- Modular Services Card Grid -->
  <section class="services-grid-section">
    <div class="container">
      <div class="services-cards-grid">
        {serviceCards.map((card) => (
          <div class={`service-box-card ${card.isDark ? 'card-dark-theme' : 'card-retro'}`}>
            <!-- Top Icon Box -->
            <div class="card-icon-wrap" style={`background: ${card.iconColor};`}>
              {card.icon === 'basket' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
              )}
              {card.icon === 'bedding' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4v16"/><path d="M2 8h18a2 2 0 0 1 2 2v10"/><path d="M2 17h20"/><path d="M6 8v9"/></svg>
              )}
              {card.icon === 'suit' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
              )}
              {card.icon === 'washer' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><circle cx="12" cy="13" r="5"/><circle cx="12" cy="13" r="2"/><line x1="8" y1="6" x2="8.01" y2="6"/><line x1="12" y1="6" x2="12.01" y2="6"/></svg>
              )}
              {card.icon === 'building' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="9" y1="22" x2="9" y2="2"/><line x1="8" y1="6" x2="8.01" y2="6"/><line x1="16" y1="6" x2="16.01" y2="6"/><line x1="8" y1="10" x2="8.01" y2="10"/><line x1="16" y1="10" x2="16.01" y2="10"/><line x1="8" y1="14" x2="8.01" y2="14"/><line x1="16" y1="14" x2="16.01" y2="14"/><line x1="8" y1="18" x2="8.01" y2="18"/><line x1="16" y1="18" x2="16.01" y2="18"/></svg>
              )}
              {card.icon === 'fitness' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 16.326A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/><path d="M12 12v6"/><path d="M9 15l3 3 3-3"/></svg>
              )}
              {card.icon === 'delivery' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              )}
              {card.icon === 'phone' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              )}
            </div>

            <!-- Card Heading -->
            <h2 class="card-service-title">{card.title}</h2>

            <!-- Card Description -->
            <p class="card-service-desc">{card.desc}</p>

            <!-- Card Checklist Bullets -->
            <ul class="card-checklist">
              {card.bullets.map((bullet) => (
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>

            <!-- Bottom Button -->
            <div class="card-btn-wrap">
              <a
                href={card.btnHref}
                class={`card-action-btn ${card.isDark ? 'btn-dark-cta' : 'btn-light-cta'}`}
              >
                <span>{card.btnText}</span>
                <span class="btn-arrow">&rarr;</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Photo Gallery -->
  <PhotoGallery />

  <!-- Bottom CTA Banner -->
  <section class="bottom-cta-section">
    <div class="container text-center">
      <div class="cta-box card-retro">
        <h2 class="cta-heading font-bebas">VISIT LASKEY'S LAUNDRY TODAY</h2>
        <p class="cta-text">
          Conveniently located at 3330 W Laskey Rd, right on Laskey and Secor in Toledo, OH. Drop off your laundry or wash with ease 7 days a week!
        </p>
        <div class="cta-btn-row">
          <a
            href="https://maps.google.com/?q=3330+W+Laskey+Rd+Toledo+OH+43623"
            target="_blank"
            rel="noopener noreferrer"
            id="services-get-directions"
            class="btn-retro-red btn-get-directions"
            data-gtm-category="directions"
            data-gtm-action="click"
            data-gtm-label="services_directions"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            GET DIRECTIONS TO 3330 W LASKEY RD
          </a>
          <a href="tel:4192140778" class="btn-retro-secondary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
            CALL US: (419) 214-0778
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background: var(--bg-cream-dark);
    padding: 60px 0 40px;
    text-align: center;
    border-bottom: 3px solid var(--border-dark);
  }

  .header-title {
    font-size: 3.8rem;
    margin-top: 12px;
    margin-bottom: 12px;
  }

  .header-desc {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 750px;
    margin: 0 auto;
  }

  /* Services Grid Section */
  .services-grid-section {
    padding: 60px 0;
  }

  .services-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .service-box-card {
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    position: relative;
    background: #ffffff;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .service-box-card:hover {
    transform: translateY(-4px);
  }

  /* Dark Theme Card */
  .card-dark-theme {
    background: #0f172a;
    color: #ffffff;
    border: 3px solid #000000;
    box-shadow: 6px 6px 0px #000000;
  }

  .card-dark-theme .card-service-title {
    color: #ffffff;
  }

  .card-dark-theme .card-service-desc {
    color: #cbd5e1;
  }

  .card-dark-theme .card-checklist li {
    color: #f1f5f9;
  }

  /* Top Icon Box */
  .card-icon-wrap {
    width: 52px;
    height: 52px;
    border-radius: 10px;
    border: 2px solid var(--border-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    box-shadow: 2px 2px 0px #000;
  }

  .card-service-title {
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: 12px;
    color: var(--text-dark);
  }

  .card-service-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 20px;
  }

  /* Checklist Bullets */
  .card-checklist {
    list-style: none;
    padding: 0;
    margin: 0 0 28px 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex-grow: 1;
  }

  .card-checklist li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-dark);
    line-height: 1.4;
  }

  .card-checklist svg {
    flex-shrink: 0;
    margin-top: 1px;
  }

  /* Action Buttons */
  .card-btn-wrap {
    margin-top: auto;
  }

  .card-action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 12px 16px;
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.5px;
    text-decoration: none;
    border-radius: 8px;
    border: 2px solid var(--border-dark);
    box-shadow: 3px 3px 0px #000;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    text-align: center;
  }

  .card-action-btn:hover {
    transform: translateY(-2px);
    box-shadow: 5px 5px 0px #000;
  }

  .btn-light-cta {
    background: #f8fafc;
    color: var(--text-dark);
  }

  .btn-light-cta:hover {
    background: var(--brand-red);
    color: #ffffff;
  }

  .btn-dark-cta {
    background: #f97316;
    color: #000000;
  }

  .btn-dark-cta:hover {
    background: #ea580c;
    color: #ffffff;
  }

  .btn-arrow {
    font-size: 1.1rem;
    transition: transform 0.15s ease;
  }

  .card-action-btn:hover .btn-arrow {
    transform: translateX(4px);
  }

  /* Bottom CTA */
  .bottom-cta-section {
    padding: 60px 0;
  }

  .cta-box {
    background: #ffffff;
    padding: 48px;
    max-width: 850px;
    margin: 0 auto;
  }

  .cta-heading {
    font-size: 3rem;
    margin-bottom: 12px;
  }

  .cta-text {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto 30px;
  }

  .cta-btn-row {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .services-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 680px) {
    .services-cards-grid {
      grid-template-columns: 1fr;
    }

    .header-title {
      font-size: 2.8rem;
    }

    .cta-box {
      padding: 28px 20px;
    }
  }
</style>
