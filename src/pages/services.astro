---
import Layout from '../layouts/Layout.astro';
import PhotoGallery from '../components/PhotoGallery.astro';

const servicesList = [
  {
    id: 'wash-and-fold',
    badge: 'ATTENDANT SERVICE · CASH ONLY',
    title: 'DROP-OFF WASH & FOLD LAUNDRY',
    tagline: 'Save hours every week with professional attendant washing, drying, and folding.',
    description: 'Bring your everyday laundry to our counter between 7:00 AM and 7:00 PM daily. We sort whites and darks, wash with premium detergents (Tide, Gain, or Free & Clear), dry to perfection, and fold everything into sealed plastic wrap ready for your dresser.',
    rates: [
      { name: 'Next-Day Wash & Fold', price: '$1.50 / lb', note: '10 lb minimum · Ready in 24 hrs' },
      { name: 'Same-Day Express', price: '$2.00 / lb', note: 'Drop off by 10am · Ready by 4pm' },
      { name: 'Bedding & Comforters', price: '$2.00 / lb', note: 'King, Queen, Quilts & Rugs' },
    ],
    features: [
      'Separated whites, colors, and darks',
      'Choice of Tide, Gain, or Hypoallergenic Free & Clear',
      'Fabric softener or fragrance-free options',
      'Attendants inspect and follow care labels',
      'Text notification when order is ready',
      'Cash Only payment (on-site ATM available)',
    ],
    linkHref: '/wash-and-fold',
    linkText: 'VIEW FULL WASH & FOLD DETAILS & PRICING',
  },
  {
    id: 'specialty-care',
    badge: 'SPECIALTY WASHING & LINENS',
    title: 'COMFORTERS, SUITS & SPECIALTY GARMENTS',
    tagline: 'Custom wash and fold care for bulky bedding, washable suits, and delicate items.',
    description: 'Not all laundry is just t-shirts and jeans. We provide specialized wash cycles and customized care for heavy household bedding, delicate items, athletic gear, and work uniforms.',
    items: [
      {
        title: 'King & Queen Comforters',
        desc: 'Bulky down comforters, duvets, handmade quilts, and weighted blankets washed in high-capacity drums and gently dried so fills remain fluffy without clumping.',
      },
      {
        title: 'Washable Suits & Blazers',
        desc: 'Careful cold-water wash and low-tumble or air-dry finishing for washable blazers, suit pants, dress shirts, and uniform jackets.',
      },
      {
        title: 'Delicate Garments & Blouses',
        desc: 'Gentle cycle washing with hypoallergenic soap, low-spin protection, and gentle handling for sweaters, lace, and synthetics.',
      },
      {
        title: 'Sports & Odor-Eliminating Activewear',
        desc: 'High-performance sportswear washing designed to break down sweat oils, bacteria, and turf grime from gym clothes and sports gear.',
      },
    ],
    linkHref: '/wash-and-fold#pricing',
    linkText: 'SEE SPECIALTY DROP-OFF RATES',
  },
  {
    id: 'self-service',
    badge: 'OPEN 7 DAYS: 7AM – 9PM',
    title: 'SELF-SERVICE COIN & CARD LAUNDROMAT',
    tagline: 'Toledo’s cleanest, brightest laundromat with 20lb to 80lb high-efficiency machines.',
    description: 'Prefer to do your own wash? Our spotless facility features modern stainless steel Huebsch equipment that accepts credit cards, quarters, or coin payments directly on the machines. High-spin extraction cuts dry times down to just 15–20 minutes so you can finish all your loads in under 45 minutes.',
    rates: [
      { name: 'Small & Double Loads', price: '20lb – 30lb Washers', note: 'Fast 25-min wash cycle' },
      { name: 'Family & Triple Loads', price: '40lb Washers', note: 'Fits 3–4 standard baskets' },
      { name: 'Mega Comforter Washers', price: '60lb – 80lb Washers', note: 'Fits giant King comforters' },
    ],
    features: [
      'Accepts Credit Cards & Quarters directly on machines',
      'Dual bill-to-quarter change machines on site',
      'On-site cash ATM for immediate convenience',
      'High-heat express dryers with anti-wrinkle cool-down',
      'Free high-speed customer Wi-Fi & comfortable seating',
      'Full vending for Tide, Gain, Bounce, snacks & cold drinks',
    ],
    linkHref: '/self-service',
    linkText: 'VIEW WASHER SIZES & AMENITIES',
  },
  {
    id: 'commercial',
    badge: 'SMALL BUSINESS & AIRBNB ACCOUNTS',
    title: 'COMMERCIAL LAUNDRY & LINEN SERVICE',
    tagline: 'Reliable laundry service for Toledo businesses, Airbnb hosts, and medical clinics.',
    description: 'Keep your business running smoothly with crisp, sanitized, professionally folded linens. We serve local Toledo short-term rentals, hair salons, barbershops, fitness centers, chiropractic clinics, and caterers with flexible drop-off or scheduled turnarounds.',
    items: [
      {
        title: 'Airbnb & Vacation Rentals',
        desc: 'Bed sheets, duvet covers, pillowcases, bath sheets, hand towels, and kitchen dishcloths washed, sanitized, and neatly packaged for fast turnovers.',
      },
      {
        title: 'Salons, Spas & Barbershops',
        desc: 'Towel washing and stain removal for hair salon capes, facial towels, massage linens, and bleach-safe styling towels.',
      },
      {
        title: 'Fitness Centers & Gyms',
        desc: 'High-volume workout towels, sweat rags, and microfibers washed with odor-neutralizing commercial detergents.',
      },
      {
        title: 'Medical & Dental Practices',
        desc: 'Sanitized scrubs, patient gowns, lab coats, and barrier towels returned spotless and hygienic.',
      },
    ],
    linkHref: '/location',
    linkText: 'CONTACT US FOR COMMERCIAL ACCOUNTS',
  },
  {
    id: 'delivery',
    badge: 'COMING SOON ACROSS TOLEDO',
    title: 'DOOR-TO-DOOR PICKUP & DELIVERY',
    tagline: 'Effortless laundry pickup from your porch with delivery right back to your door.',
    description: 'We are launching door-to-door laundry delivery in Greater Toledo! Simply bag your dirty laundry, schedule a pickup, and receive freshly laundered, folded clothes in 24–48 hours without leaving your home.',
    features: [
      'Contactless porch pickup & drop-off',
      'Serving Toledo, Sylvania, Maumee, and Perrysburg launch routes',
      'FREE delivery on household orders over 30 lbs',
      'Customizable detergent, softener, and folding preferences',
      'Early access waitlist now open for launch discounts',
    ],
    linkHref: '/pickup-and-delivery',
    linkText: 'CHECK YOUR ZIP CODE & JOIN WAITLIST',
  },
];

const faqs = [
  {
    q: 'Can I wash giant king-size comforters and heavy quilts at Laskey’s Laundry?',
    a: 'Yes! You can either drop them off for our attendant wash & fold ($2.00/lb) or use our giant 60lb and 80lb self-service commercial washers. These machines are engineered with massive wash drums to give heavy bedding room to tumble and sanitize thoroughly.',
  },
  {
    q: 'Can I drop off washable suits, blazers, and dress shirts for wash & fold?',
    a: 'Yes. For washable workwear, dress shirts, blouses, and washable blazers, our attendants follow delicate care instructions including cold-water wash, gentle cycles, and low-heat tumbling to preserve fabrics and color vibrancy.',
  },
  {
    q: 'What payment methods do you accept?',
    a: 'For self-service laundromat machines, we accept both credit cards and quarters. For drop-off wash & fold services, payment is Cash Only. We have an on-site ATM and dual bill-to-quarter changers inside the store.',
  },
  {
    q: 'What are your drop-off and store hours?',
    a: 'Our self-service laundromat is open 7:00 AM – 9:00 PM daily (last wash at 8:00 PM). Drop-off wash & fold counter service is open 7:00 AM – 7:00 PM daily, 365 days a year.',
  },
  {
    q: 'Do you provide laundry services for local Toledo businesses and Airbnb hosts?',
    a: 'Yes! We support local Toledo short-term rental hosts, salons, spas, fitness studios, and healthcare practices with fast, dependable linen and towel laundry service.',
  },
  {
    q: 'When is pickup and delivery launching in Toledo?',
    a: 'Delivery is currently in final testing and launching soon! You can check your ZIP code on our Pickup & Delivery page and join the early access waitlist to receive launch notifications and special promotions.',
  },
];
---

<Layout
  title="All Laundry Services - Laskey's Laundry Toledo OH"
  description="Comprehensive laundry services in Toledo, OH. Drop-off wash & fold ($1.50-$2.00/lb), comforters & suits, self-service coin/card machines (up to 80lb), commercial linens, and upcoming delivery."
  activeTab="services"
>
  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <span class="pill-badge">TOLEDO LAUNDRY SOLUTIONS</span>
      <h1 class="header-title">OUR LAUNDRY SERVICES</h1>
      <p class="header-desc">
        From full-service attendant wash & fold and king-size comforter care to modern self-service coin & card machines, Laskey's Laundry has the right solution for your clothes and household linens.
      </p>

      <!-- Quick Nav Jump Anchor Bar -->
      <div class="services-nav-bar">
        <a href="#wash-and-fold" class="service-nav-pill">Wash & Fold</a>
        <a href="#specialty-care" class="service-nav-pill">Comforters & Suits</a>
        <a href="#self-service" class="service-nav-pill">Self-Service Laundromat</a>
        <a href="#commercial" class="service-nav-pill">Commercial & Airbnb</a>
        <a href="#delivery" class="service-nav-pill">Pickup & Delivery</a>
      </div>
    </div>
  </section>

  <!-- Main Services Container -->
  <section class="services-list-section">
    <div class="container">
      <!-- Service 1: Wash & Fold -->
      <div id="wash-and-fold" class="service-block card-retro">
        <div class="service-block-header">
          <span class="service-category-badge">{servicesList[0].badge}</span>
          <h2 class="service-block-title">{servicesList[0].title}</h2>
          <p class="service-block-tagline">{servicesList[0].tagline}</p>
        </div>

        <p class="service-block-desc">{servicesList[0].description}</p>

        <!-- Rates Table -->
        <div class="rates-grid">
          {servicesList[0].rates?.map((rate) => (
            <div class="rate-card">
              <span class="rate-name">{rate.name}</span>
              <span class="rate-price font-bebas">{rate.price}</span>
              <span class="rate-note">{rate.note}</span>
            </div>
          ))}
        </div>

        <!-- Features Grid -->
        <div class="service-features-wrap">
          <h3 class="features-heading font-bebas">WHAT’S INCLUDED WITH DROP-OFF:</h3>
          <ul class="features-columns">
            {servicesList[0].features?.map((f) => (
              <li>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="service-actions">
          <a href={servicesList[0].linkHref} class="btn-retro-red service-cta-btn">
            {servicesList[0].linkText} &rarr;
          </a>
        </div>
      </div>

      <!-- Service 2: Specialty Items (Comforters, Suits, Delicates) -->
      <div id="specialty-care" class="service-block card-retro">
        <div class="service-block-header">
          <span class="service-category-badge">{servicesList[1].badge}</span>
          <h2 class="service-block-title">{servicesList[1].title}</h2>
          <p class="service-block-tagline">{servicesList[1].tagline}</p>
        </div>

        <p class="service-block-desc">{servicesList[1].description}</p>

        <!-- Specialty Cards Grid -->
        <div class="specialty-grid">
          {servicesList[1].items?.map((item) => (
            <div class="specialty-card">
              <h3 class="specialty-title font-bebas">{item.title}</h3>
              <p class="specialty-text">{item.desc}</p>
            </div>
          ))}
        </div>

        <div class="service-actions">
          <a href={servicesList[1].linkHref} class="btn-retro-red service-cta-btn">
            {servicesList[1].linkText} &rarr;
          </a>
        </div>
      </div>

      <!-- Service 3: Self-Service Laundromat -->
      <div id="self-service" class="service-block card-retro">
        <div class="service-block-header">
          <span class="service-category-badge">{servicesList[2].badge}</span>
          <h2 class="service-block-title">{servicesList[2].title}</h2>
          <p class="service-block-tagline">{servicesList[2].tagline}</p>
        </div>

        <p class="service-block-desc">{servicesList[2].description}</p>

        <!-- Machine Sizes Grid -->
        <div class="rates-grid">
          {servicesList[2].rates?.map((rate) => (
            <div class="rate-card">
              <span class="rate-name">{rate.name}</span>
              <span class="rate-price font-bebas">{rate.price}</span>
              <span class="rate-note">{rate.note}</span>
            </div>
          ))}
        </div>

        <!-- Amenities Features -->
        <div class="service-features-wrap">
          <h3 class="features-heading font-bebas">STORE AMENITIES & FEATURES:</h3>
          <ul class="features-columns">
            {servicesList[2].features?.map((f) => (
              <li>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="service-actions">
          <a href={servicesList[2].linkHref} class="btn-retro-red service-cta-btn">
            {servicesList[2].linkText} &rarr;
          </a>
        </div>
      </div>

      <!-- Service 4: Commercial & Airbnb Laundry -->
      <div id="commercial" class="service-block card-retro">
        <div class="service-block-header">
          <span class="service-category-badge">{servicesList[3].badge}</span>
          <h2 class="service-block-title">{servicesList[3].title}</h2>
          <p class="service-block-tagline">{servicesList[3].tagline}</p>
        </div>

        <p class="service-block-desc">{servicesList[3].description}</p>

        <!-- Commercial Niches -->
        <div class="specialty-grid">
          {servicesList[3].items?.map((item) => (
            <div class="specialty-card">
              <h3 class="specialty-title font-bebas">{item.title}</h3>
              <p class="specialty-text">{item.desc}</p>
            </div>
          ))}
        </div>

        <div class="service-actions">
          <a href={servicesList[3].linkHref} class="btn-retro-secondary service-cta-btn">
            {servicesList[3].linkText} &rarr;
          </a>
        </div>
      </div>

      <!-- Service 5: Pickup & Delivery -->
      <div id="delivery" class="service-block card-retro">
        <div class="service-block-header">
          <span class="service-category-badge" style="background: #374151; border-color: #1f2937;">{servicesList[4].badge}</span>
          <h2 class="service-block-title">{servicesList[4].title}</h2>
          <p class="service-block-tagline">{servicesList[4].tagline}</p>
        </div>

        <p class="service-block-desc">{servicesList[4].description}</p>

        <!-- Delivery Highlights -->
        <div class="service-features-wrap">
          <h3 class="features-heading font-bebas">DELIVERY HIGHLIGHTS:</h3>
          <ul class="features-columns">
            {servicesList[4].features?.map((f) => (
              <li>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="service-actions">
          <a href={servicesList[4].linkHref} class="btn-retro-red service-cta-btn">
            {servicesList[4].linkText} &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Photo Gallery -->
  <PhotoGallery />

  <!-- Services FAQ Accordion / Grid -->
  <section class="faq-section">
    <div class="container">
      <div class="section-title text-center">
        <span class="pill-badge">HAVE QUESTIONS?</span>
        <h2>FREQUENTLY ASKED QUESTIONS</h2>
        <p class="sub-text">Everything you need to know about our Toledo laundry services, pricing, and machine options.</p>
      </div>

      <div class="faq-grid">
        {faqs.map((faq) => (
          <div class="faq-card card-retro">
            <h3 class="faq-question font-bebas">{faq.q}</h3>
            <p class="faq-answer">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom Location CTA Banner -->
  <section class="bottom-cta-section">
    <div class="container text-center">
      <div class="cta-box card-retro">
        <h2 class="cta-heading font-bebas">VISIT LASKEY'S LAUNDRY TODAY</h2>
        <p class="cta-text">
          Located right on Laskey and Secor in Toledo, OH. Drop off your laundry or wash with ease 7 days a week!
        </p>
        <div class="cta-btn-row">
          <a
            href="https://maps.google.com/?q=3330+W+Laskey+Rd+Toledo+OH+43623"
            target="_blank"
            rel="noopener noreferrer"
            id="services-get-directions"
            class="btn-retro-red btn-get-directions"
            data-gtm-category="directions"
            data-gtm-action="click"
            data-gtm-label="services_directions"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            GET DIRECTIONS TO 3330 W LASKEY RD
          </a>
          <a href="tel:4192140778" class="btn-retro-secondary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
            CALL US: (419) 214-0778
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background: var(--bg-cream-dark);
    padding: 60px 0 40px;
    text-align: center;
    border-bottom: 3px solid var(--border-dark);
  }

  .header-title {
    font-size: 3.8rem;
    margin-top: 12px;
    margin-bottom: 12px;
  }

  .header-desc {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 750px;
    margin: 0 auto;
  }

  /* Quick Nav Pills */
  .services-nav-bar {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
  }

  .service-nav-pill {
    background: #ffffff;
    border: 2px solid var(--border-dark);
    padding: 8px 18px;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-dark);
    text-decoration: none;
    box-shadow: 2px 2px 0 #000;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .service-nav-pill:hover {
    background: var(--brand-blue);
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 4px 4px 0 #000;
  }

  /* Services List Section */
  .services-list-section {
    padding: 60px 0;
  }

  .service-block {
    padding: 40px;
    margin-bottom: 48px;
    background: #ffffff;
  }

  .service-block-header {
    margin-bottom: 16px;
  }

  .service-category-badge {
    display: inline-block;
    background: var(--brand-red);
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 1px;
    padding: 4px 12px;
    border: 2px solid var(--border-dark);
    margin-bottom: 10px;
  }

  .service-block-title {
    font-size: 2.8rem;
    margin-bottom: 6px;
  }

  .service-block-tagline {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--brand-blue);
  }

  .service-block-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 24px;
    max-width: 900px;
  }

  /* Rates Grid */
  .rates-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-bottom: 28px;
  }

  .rate-card {
    background: var(--bg-cream-dark);
    border: 2px solid var(--border-dark);
    padding: 16px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .rate-name {
    font-weight: 700;
    font-size: 0.95rem;
  }

  .rate-price {
    font-size: 2rem;
    color: var(--brand-red);
    line-height: 1.1;
  }

  .rate-note {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* Features List */
  .service-features-wrap {
    margin-bottom: 28px;
  }

  .features-heading {
    font-size: 1.4rem;
    letter-spacing: 1px;
    margin-bottom: 12px;
  }

  .features-columns {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .features-columns li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .features-columns svg {
    flex-shrink: 0;
    color: var(--brand-red);
    margin-top: 2px;
  }

  /* Specialty Cards Grid */
  .specialty-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 28px;
  }

  .specialty-card {
    background: var(--bg-cream-dark);
    border: 2px solid var(--border-dark);
    padding: 20px;
  }

  .specialty-title {
    font-size: 1.5rem;
    letter-spacing: 1px;
    margin-bottom: 8px;
    color: var(--text-dark);
  }

  .specialty-text {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Service Actions */
  .service-actions {
    margin-top: 24px;
  }

  .service-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    font-size: 1.1rem;
    text-decoration: none;
  }

  /* FAQ Section */
  .faq-section {
    padding: 60px 0;
    background: var(--bg-cream-dark);
    border-top: 3px solid var(--border-dark);
    border-bottom: 3px solid var(--border-dark);
  }

  .section-title h2 {
    font-size: 3rem;
    margin-top: 10px;
    margin-bottom: 8px;
  }

  .sub-text {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto 40px;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .faq-card {
    background: #ffffff;
    padding: 28px;
  }

  .faq-question {
    font-size: 1.4rem;
    letter-spacing: 1px;
    margin-bottom: 10px;
    color: var(--text-dark);
  }

  .faq-answer {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* Bottom CTA */
  .bottom-cta-section {
    padding: 60px 0;
  }

  .cta-box {
    background: #ffffff;
    padding: 48px;
    max-width: 850px;
    margin: 0 auto;
  }

  .cta-heading {
    font-size: 3rem;
    margin-bottom: 12px;
  }

  .cta-text {
    font-size: 1.15rem;
