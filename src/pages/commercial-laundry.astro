---
import Layout from '../layouts/Layout.astro';
import PhotoGallery from '../components/PhotoGallery.astro';

const commercialNiches = [
  {
    title: 'Airbnb & Short-Term Rentals',
    desc: 'Bed sheets, pillowcases, duvet covers, bath towels, and hand towels washed, sanitized, and neatly folded into turnover-ready bundles.',
  },
  {
    title: 'Hair Salons & Barbershops',
    desc: 'Deep washing and stain removal for styling towels, shampoo capes, and facial cloths with grease-cutting detergents.',
  },
  {
    title: 'Spas & Massage Therapy',
    desc: 'Gentle, scent-free washing for massage table linens, sheets, plush robes, and heated towel wraps.',
  },
  {
    title: 'Gyms & Fitness Studios',
    desc: 'High-volume towel washing with odor-neutralizing commercial formulas for sweat and athletic microfibers.',
  },
  {
    title: 'Medical & Dental Practices',
    desc: 'Hygienic laundering for patient gowns, clinic scrubs, dental bibs, and barrier cloths.',
  },
  {
    title: 'Restaurants & Catering',
    desc: 'Stain-lifting care for bar mops, kitchen towels, server aprons, and cloth table runners.',
  },
];

const faqs = [
  {
    q: 'How does commercial laundry drop-off work?',
    a: 'Bring your bulk laundry bags to our shop at 3330 W Laskey Rd between 7:00 AM and 7:00 PM daily. We weigh the load, record your detergent preferences, and provide an estimated pickup time.',
  },
  {
    q: 'What are your turnaround times for commercial accounts?',
    a: 'Standard next-day turnaround is available for most linen volumes. Same-day express is available when dropped off by 10:00 AM.',
  },
  {
    q: 'Do you provide itemized invoices and receipts for business taxes?',
    a: 'Yes. We provide clear, itemized weight and charge receipts with every order so you have complete records for your business bookkeeping.',
  },
  {
    q: 'What detergents do you use for commercial linens?',
    a: 'We offer Tide, Gain, and fragrance-free hypoallergenic Free & Clear detergents, alongside commercial stain pre-treatments and fabric softeners.',
  },
  {
    q: 'Is pickup and delivery available for commercial accounts?',
    a: 'Delivery is currently in final testing and launching soon across Toledo. In the meantime, daily attendant drop-off is open 7:00 AM to 7:00 PM.',
  },
];
---

<Layout
  title="Commercial Laundry & Airbnb Linen Service - Laskey's Laundry Toledo"
  description="Dependable commercial laundry and Airbnb linen service in Toledo, OH. Fast turnaround, sanitized sheets and towels for vacation rentals, salons, gyms, and clinics."
  activeTab="services"
>
  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <span class="pill-badge">BUSINESS & RENTAL LINENS</span>
      <h1 class="header-title">COMMERCIAL LAUNDRY & AIRBNB LINEN SERVICE</h1>
      <p class="header-desc">
        Fast, dependable commercial laundry for Toledo short-term rental hosts, salons, fitness studios, and healthcare practices. Clean, sanitized, and packaged for immediate use.
      </p>
      <div class="header-payment-tag">
        DROP-OFF 7:00 AM – 7:00 PM DAILY · CASH ONLY (ATM ON SITE) · TOLEDO, OH
      </div>
    </div>
  </section>

  <!-- Split Section 1: Business Laundry Needs -->
  <section class="split-section">
    <div class="container">
      <div class="split-row">
        <!-- Text Left -->
        <div class="split-text-col">
          <span class="section-tag">RELIABLE TURNOVER</span>
          <h2 class="split-heading">KEEP YOUR GUESTS & CLIENTS IMPRESSED</h2>
          <p class="split-paragraph">
            Linen management takes hours out of your business operations. Whether you are turning over a 5-star Airbnb property or stocking clean towels for a busy salon schedule, clean linens are critical to your reputation.
          </p>
          <p class="split-paragraph">
            Our attendants wash commercial batches in high-capacity Huebsch machines, sanitize at optimal wash temperatures, and package finished items in sealed wrap so they stay fresh during transport.
          </p>
          <ul class="split-checklist">
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Sanitized Bed Sheets, Duvets & Pillowcases</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Plush Bath Towels, Hand Towels & Washcloths</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Itemized Receipts for Straightforward Expense Tracking</span>
            </li>
          </ul>
        </div>

        <!-- Image Right (Polaroid Frame) -->
        <div class="split-image-col">
          <div class="polaroid-frame" style="transform: rotate(1.5deg);">
            <div class="polaroid-tape"></div>
            <div class="img-wrapper">
              <img src="/images/IMG_7078.webp" alt="Heavy-duty commercial washer banks at Laskey's Laundry Toledo" loading="lazy" />
            </div>
            <div class="polaroid-caption font-bebas">HEAVY-DUTY COMMERCIAL WASHER BANKS</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Split Section 2: Industries Served -->
  <section class="split-section bg-alt">
    <div class="container">
      <div class="split-row reverse">
        <!-- Text Right -->
        <div class="split-text-col">
          <span class="section-tag">COMMERCIAL CATEGORIES</span>
          <h2 class="split-heading">INDUSTRIES WE PROUDLY SERVE IN TOLEDO</h2>
          <p class="split-paragraph">
            We handle bulk laundry requirements across diverse Toledo small businesses. From high-turnover hospitality to medical clinic scrubs, we customize wash cycles to your fabric needs.
          </p>
          <div class="industry-grid">
            {commercialNiches.slice(0, 4).map((niche) => (
              <div class="industry-card card-retro">
                <div class="industry-title font-bebas">{niche.title}</div>
                <div class="industry-desc">{niche.desc}</div>
              </div>
            ))}
          </div>
          <div class="split-btn-wrap">
            <a
              href="https://maps.google.com/?q=3330+W+Laskey+Rd+Toledo+OH+43623"
              target="_blank"
              rel="noopener noreferrer"
              id="commercial-get-directions"
              class="btn-retro-red btn-get-directions"
              data-gtm-category="directions"
              data-gtm-action="click"
              data-gtm-label="commercial_page_directions"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
              GET DIRECTIONS TO DROP OFF
            </a>
          </div>
        </div>

        <!-- Image Left (Polaroid Frame) -->
        <div class="split-image-col">
          <div class="polaroid-frame" style="transform: rotate(-1.5deg);">
            <div class="polaroid-tape"></div>
            <div class="img-wrapper">
              <img src="/images/IMG_7077.webp" alt="Stainless stacked dryers and folding tables at Laskey's Laundry" loading="lazy" />
            </div>
            <div class="polaroid-caption font-bebas">EXPRESS DRYING & PACKAGING</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Photo Gallery -->
  <PhotoGallery />

  <!-- FAQs Section -->
  <section class="faq-section">
    <div class="container">
      <div class="section-title text-center">
        <span class="pill-badge">HAVE QUESTIONS?</span>
        <h2>COMMERCIAL LAUNDRY FAQS</h2>
        <p class="sub-text">Answers for Toledo business owners and property managers.</p>
      </div>

      <div class="faq-grid">
        {faqs.map((faq) => (
          <div class="faq-card card-retro">
            <h3 class="faq-question font-bebas">{faq.q}</h3>
            <p class="faq-answer">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA Banner -->
  <section class="bottom-cta-section">
    <div class="container text-center">
      <div class="cta-box card-retro">
        <h2 class="cta-heading font-bebas">PARTNER WITH LASKEY'S LAUNDRY</h2>
        <p class="cta-text">
          Located at 3330 W Laskey Rd, right on Laskey and Secor in Toledo, OH. Drop off your business linens daily between 7:00 AM and 7:00 PM. Cash only (ATM on site).
        </p>
        <div class="cta-btn-row">
          <a
            href="https://maps.google.com/?q=3330+W+Laskey+Rd+Toledo+OH+43623"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-retro-red btn-get-directions"
            data-gtm-category="directions"
            data-gtm-action="click"
            data-gtm-label="commercial_footer_directions"
          >
            GET DIRECTIONS
          </a>
          <a href="tel:4192140778" class="btn-retro-secondary">
            CALL US: (419) 214-0778
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background: var(--bg-cream-dark);
    padding: 60px 0 40px;
    text-align: center;
    border-bottom: 3px solid var(--border-dark);
  }

  .header-title {
    font-size: 3.5rem;
    margin-top: 12px;
    margin-bottom: 12px;
  }

  .header-desc {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 750px;
    margin: 0 auto 20px;
  }

  .header-payment-tag {
    display: inline-block;
    background: rgba(220, 38, 38, 0.1);
    color: var(--brand-red);
    font-weight: 800;
    font-size: 0.9rem;
    letter-spacing: 0.5px;
    padding: 6px 16px;
    border: 2px solid var(--brand-red);
  }

  /* Split Sections */
  .split-section {
    padding: 70px 0;
  }

  .split-section.bg-alt {
    background: var(--bg-cream-dark);
    border-top: 3px solid var(--border-dark);
    border-bottom: 3px solid var(--border-dark);
  }

  .split-row {
    display: flex;
    align-items: center;
    gap: 48px;
  }

  .split-row.reverse {
    flex-direction: row-reverse;
  }

  .split-text-col {
    flex: 1.2;
  }

  .split-image-col {
    flex: 0.9;
  }

  .section-tag {
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: var(--brand-blue);
    display: block;
    margin-bottom: 8px;
  }

  .split-heading {
    font-size: 2.6rem;
    line-height: 1.1;
    margin-bottom: 16px;
  }

  .split-paragraph {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .split-checklist {
    list-style: none;
    padding: 0;
    margin: 20px 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .split-checklist li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 0.95rem;
  }

  /* Industry Grid */
  .industry-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 24px 0;
  }

  .industry-card {
    background: #ffffff;
    padding: 16px;
  }

  .industry-title {
    font-size: 1.3rem;
    letter-spacing: 1px;
    margin-bottom: 4px;
    color: var(--text-dark);
  }

  .industry-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .split-btn-wrap {
    margin-top: 24px;
  }

  /* Polaroid Image Wrapper */
  .img-wrapper {
    height: 320px;
    overflow: hidden;
    background: #e5e5e5;
  }

  .img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .polaroid-caption {
    text-align: center;
    margin-top: 14px;
    font-size: 1.1rem;
    letter-spacing: 1.5px;
    color: var(--text-dark);
  }

  /* FAQs Section */
  .faq-section {
    padding: 60px 0;
    background: #ffffff;
  }

  .section-title h2 {
    font-size: 3rem;
    margin-top: 10px;
    margin-bottom: 8px;
  }

  .sub-text {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto 40px;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .faq-card {
    background: var(--bg-cream-dark);
    padding: 28px;
  }

  .faq-question {
    font-size: 1.4rem;
    letter-spacing: 1px;
    margin-bottom: 10px;
    color: var(--text-dark);
  }

  .faq-answer {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* Bottom CTA */
  .bottom-cta-section {
    padding: 60px 0;
    background: var(--bg-cream-dark);
  }

  .cta-box {
    background: #ffffff;
    padding: 48px;
    max-width: 850px;
    margin: 0 auto;
  }

  .cta-heading {
    font-size: 3rem;
    margin-bottom: 12px;
  }

  .cta-text {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto 30px;
  }

  .cta-btn-row {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  @media (max-width: 860px) {
    .split-row,
    .split-row.reverse {
      flex-direction: column;
      gap: 32px;
    }

    .industry-grid,
    .faq-grid {
      grid-template-columns: 1fr;
    }

    .header-title {
      font-size: 2.8rem;
    }

    .split-heading {
      font-size: 2.2rem;
    }

    .cta-box {
      padding: 28px 20px;
    }
  }
</style>
