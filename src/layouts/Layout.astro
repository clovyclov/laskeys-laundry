---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  activeTab?: string;
}

const {
  title = "Laskey's Laundry - Toledo's Neighborhood Laundromat & Delivery",
  description = "Coin-operated laundromat, drop-off wash & fold service, and door-to-door laundry pickup & delivery in Toledo, OH. Clean, bright, high-capacity washers and dryers.",
  activeTab = "home"
} = Astro.props;
---

<!xhtml>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Laskey's Laundry, Toledo laundromat, coin laundry Toledo, wash and fold Toledo, laundry delivery Toledo, coin machines Toledo OH, 3330 W Laskey Rd, 43623" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://laskeyslaundry.com" />
    <meta property="og:image" content="/images/laskeys-laundry-building.webp" />
  </head>
  <body>
    <!-- Top Awning Stripes Accent -->
    <div class="awning-stripe" aria-hidden="true"></div>

    <!-- Site Header & Nav -->
    <Header activeTab={activeTab} />

    <!-- Main Content Area -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Site Footer -->
    <Footer />
  </body>
</html>
