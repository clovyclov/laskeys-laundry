---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  activeTab?: string;
}

const {
  title = "Laskey's Laundry - Toledo's Neighborhood Laundromat & Delivery",
  description = "Coin & credit card laundromat, same-day drop-off wash & fold, and 80lb comforter mega-washers in Toledo, OH. Clean, bright, on-site ATM, open 7 days a week.",
  activeTab = "home"
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, 'https://laskeyslaundry.com').href;
const socialImage = 'https://laskeyslaundry.com/images/laskeys-laundry-building.webp';

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Laundromat",
  "name": "Laskey's Laundry",
  "image": socialImage,
  "logo": "https://laskeyslaundry.com/logo.png",
  "@id": "https://laskeyslaundry.com/#business",
  "url": "https://laskeyslaundry.com",
  "telephone": "+1-419-214-0778",
  "priceRange": "$",
  "paymentAccepted": ["Cash", "Credit Card"],
  "currenciesAccepted": "USD",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "3330 W Laskey Rd",
    "addressLocality": "Toledo",
    "addressRegion": "OH",
    "postalCode": "43623",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 41.7142,
    "longitude": -83.6285
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
      ],
      "opens": "06:00",
      "closes": "22:00"
    }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Laskey's Laundry Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Self-Service Coin & Credit Card Laundromat",
          "description": "High-efficiency commercial Huebsch washers (20lb to 80lb) and high-heat express dryers."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Drop-Off Wash and Fold Service",
          "description": "Professional attendant wash, dry, and fold service. Next-day $1.50/lb, Same-day express $2.00/lb. Cash only."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Bulky Comforter & Bedding Washing",
          "description": "80lb mega washers designed for king comforters, quilts, rugs, and heavy blankets."
        }
      }
    ]
  }
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-KL92RQRN');</script>
    <!-- End Google Tag Manager -->

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />

    <!-- Cache Control: Ensure browsers always fetch the freshest HTML & CSS hash -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />

    <!-- Google Fonts Preconnect & Stylesheet -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Laskey's Laundry, Toledo laundromat, coin laundry Toledo, wash and fold Toledo, laundry delivery Toledo, coin machines Toledo OH, credit card laundromat, 3330 W Laskey Rd, 43623, Laskey and Secor" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content="Laskey's Laundry" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Laskey's Laundry storefront in Toledo, OH" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <!-- JSON-LD LocalBusiness Structured Data for Google Rich Results -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KL92RQRN"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!-- Top Awning Stripes Accent -->
    <div class="awning-stripe" aria-hidden="true"></div>

    <!-- Site Header & Nav -->
    <Header activeTab={activeTab} />

    <!-- Main Content Area -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Site Footer -->
    <Footer />

    <!-- GTM Event Dispatcher for Directions & Conversion Tracking -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.btn-get-directions').forEach((btn) => {
          btn.addEventListener('click', () => {
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({
              event: 'get_directions',
              event_category: 'engagement',
              event_label: btn.getAttribute('data-gtm-label') || 'directions_click',
              button_id: btn.id || 'get-directions',
            });
          });
        });
      });
    </script>
  </body>
</html>
