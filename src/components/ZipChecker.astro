---
---

<div class="zip-checker-card card-retro">
  <div class="zip-header">
    <span class="pill-badge">TOLEDO AREA DELIVERY</span>
    <h3 class="zip-title">CHECK PICKUP & DELIVERY IN YOUR NEIGHBORHOOD</h3>
    <p class="zip-desc">Enter your 5-digit ZIP code to confirm door-to-door laundry service availability.</p>
  </div>

  <div class="zip-input-row">
    <input
      type="text"
      id="zip-input"
      placeholder="e.g. 43613"
      maxlength="5"
      class="zip-input"
    />
    <button id="zip-btn" class="btn-retro-red" style="transform: none; margin: 0;">
      CHECK ZIP CODE
    </button>
  </div>

  <div id="zip-result" class="zip-result hidden"></div>

  <!-- Delivery Highlights -->
  <div class="delivery-features">
    <div class="feature-item">
      <span class="feature-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
      </span>
      <div>
        <strong>Door-to-Door Service</strong>
        <p>We pick up from your porch or doorstep and return fresh folded clothes in 24 hours.</p>
      </div>
    </div>
    <div class="feature-item">
      <span class="feature-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
      </span>
      <div>
        <strong>FREE Delivery on 30+ lbs</strong>
        <p>No delivery fee when you bundle family loads or bedding items.</p>
      </div>
    </div>
  </div>
</div>

<script>
  const VALID_ZIPS = [
    '43613', '43612', '43623', '43614', '43606',
    '43615', '43607', '43608', '43609', '43611',
    '43620', '43604', '43560', '43551'
  ];

  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('zip-input') as HTMLInputElement | null;
    const btn = document.getElementById('zip-btn');
    const result = document.getElementById('zip-result');

    if (!input || !btn || !result) return;

    function checkZip() {
      if (!input || !result) return;
      const val = input.value.trim();
      if (val.length < 5) {
        result.className = 'zip-result error';
        result.textContent = 'Please enter a valid 5-digit ZIP code.';
        result.classList.remove('hidden');
        return;
      }

      if (VALID_ZIPS.includes(val)) {
        result.className = 'zip-result success';
        result.innerHTML = `
          <strong>YES! We service ZIP ${val}!</strong>
          <p style="margin-top: 4px; font-size: 0.9rem;">Free pickup available on orders over 30 lbs. Next pickup window tomorrow morning.</p>
          <a href="#pickup-form" class="btn-retro-red" style="margin-top: 12px; transform: none; font-size: 1rem; padding: 8px 18px;">REQUEST PICKUP NOW</a>
        `;
        result.classList.remove('hidden');
      } else {
        result.className = 'zip-result warning';
        result.innerHTML = `
          <strong>ZIP ${val} is just outside our standard route.</strong>
          <p style="margin-top: 4px; font-size: 0.9rem;">Give us a quick call at <strong>(419) 214-0778</strong> — we often accommodate special nearby routes!</p>
        `;
        result.classList.remove('hidden');
      }
    }

    btn.addEventListener('click', checkZip);
    input.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') checkZip();
    });
  });
</script>

<style>
  .zip-checker-card {
    padding: 32px;
    background: #ffffff;
  }

  .zip-title {
    font-size: 2rem;
    margin-top: 10px;
    margin-bottom: 8px;
  }

  .zip-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 20px;
  }

  .zip-input-row {
    display: flex;
    gap: 12px;
    margin-bottom: 16px;
  }

  .zip-input {
    flex: 1;
    border: 3px solid var(--border-dark);
    padding: 12px 16px;
    font-size: 1.1rem;
    font-family: inherit;
    font-weight: 700;
    background: var(--bg-cream);
  }

  .zip-input:focus {
    outline: none;
    background: #ffffff;
    border-color: var(--brand-red);
  }

  .zip-result {
    padding: 16px;
    border: 2px solid var(--border-dark);
    margin-bottom: 24px;
  }

  .zip-result.hidden {
    display: none;
  }

  .zip-result.success {
    background: #dcfce7;
    border-color: #16a34a;
    color: #14532d;
  }

  .zip-result.warning {
    background: #fef9c3;
    border-color: #ca8a04;
    color: #713f12;
  }

  .zip-result.error {
    background: #fee2e2;
    border-color: #dc2626;
    color: #7f1d1d;
  }

  .delivery-features {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px dashed var(--border-dark);
  }

  .feature-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .feature-icon {
    font-size: 1.8rem;
    line-height: 1;
  }

  .feature-item strong {
    display: block;
    font-size: 0.95rem;
    color: var(--text-dark);
  }

  .feature-item p {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 2px;
  }

  @media (max-width: 600px) {
    .zip-input-row {
      flex-direction: column;
    }
    .delivery-features {
      grid-template-columns: 1fr;
    }
  }
</style>
