---
interface Props {
  activeTab?: string;
}

const { activeTab = 'home' } = Astro.props;

const navItems = [
  { id: 'home', label: 'Home', href: '/' },
  { id: 'self-service', label: 'Self-Service Coin', href: '/self-service' },
  { id: 'wash-and-fold', label: 'Wash & Fold Drop-Off', href: '/wash-and-fold' },
  { id: 'pickup-and-delivery', label: 'Pickup & Delivery', href: '/pickup-and-delivery' },
  { id: 'location', label: 'Hours & Location', href: '/location' },
];
---

<header class="header-root">
  <div class="container header-top">
    <!-- Brand Logo -->
    <a href="/" class="brand-link" aria-label="Laskey's Laundry Homepage">
      <img src="/logo.png" alt="Laskey's Laundry Logo" class="logo-image" />
      <div class="logo-text-wrap">
        <span class="logo-main">LASKEY'S</span>
        <span class="logo-sub">LAUNDRY</span>
      </div>
    </a>

    <!-- Top Contact & Address Badge -->
    <div class="header-info">
      <div class="header-address">3330 W Laskey Rd · Toledo, OH 43623</div>
      <div class="header-contact">
        <a href="tel:4192140778" class="phone-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
          (419) 214-0778
        </a>
        <span class="status-badge">• Open 7 Days</span>
      </div>
    </div>
  </div>

  <!-- Navigation Bar -->
  <nav class="nav-bar">
    <div class="container nav-container">
      <div class="nav-links">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`nav-link ${activeTab === item.id ? 'active' : ''}`}
          >
            {item.label}
          </a>
        ))}
      </div>

      <div class="nav-cta-wrap">
        <a href="/pickup-and-delivery" class="nav-cta-btn">
          <span>SCHEDULE PICKUP</span>
        </a>
      </div>
    </div>
  </nav>
</header>

<style>
  .header-root {
    background: var(--bg-cream-light);
    border-bottom: 3px solid var(--border-dark);
  }

  .header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    gap: 20px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
  }

  .logo-image {
    width: 52px;
    height: 52px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .logo-text-wrap {
    display: flex;
    flex-direction: column;
  }

  .logo-main {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 32px;
    letter-spacing: 1px;
    line-height: 0.9;
    color: var(--text-dark);
  }

  .logo-sub {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 15px;
    letter-spacing: 6px;
    line-height: 1;
    color: var(--brand-red);
  }

  .header-info {
    text-align: right;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.5;
  }

  .header-address {
    color: var(--text-dark);
  }

  .header-contact {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 2px;
  }

  .phone-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--brand-red);
    text-decoration: none;
    font-weight: 700;
  }

  .phone-link:hover {
    text-decoration: underline;
  }

  .status-badge {
    color: #15803d;
    font-weight: 700;
    font-size: 13px;
    background: #dcfce7;
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid #86efac;
  }

  /* Navigation Bar */
  .nav-bar {
    background: var(--text-dark);
    color: var(--bg-cream);
    border-top: 2px solid var(--border-dark);
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-links {
    display: flex;
    gap: 4px;
    overflow-x: auto;
  }

  .nav-link {
    display: inline-block;
    padding: 14px 20px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.15rem;
    letter-spacing: 1px;
    color: #e5e5e5;
    text-decoration: none;
    border-bottom: 4px solid transparent;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }

  .nav-link.active {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.12);
    border-bottom-color: var(--brand-red);
  }

  .nav-cta-btn {
    display: inline-flex;
    align-items: center;
    background: var(--brand-red);
    color: #ffffff;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.1rem;
    letter-spacing: 1px;
    padding: 8px 16px;
    border: 2px solid #ffffff;
    box-shadow: 2px 2px 0px #000000;
    transition: all 0.15s ease;
    margin: 8px 0;
  }

  .nav-cta-btn:hover {
    background: var(--brand-red-hover);
    transform: translateY(-1px);
    box-shadow: 3px 3px 0px #000000;
  }

  @media (max-width: 768px) {
    .header-top {
      flex-direction: column;
      align-items: flex-start;
      padding: 16px;
    }
    .header-info {
      text-align: left;
    }
    .header-contact {
      justify-content: flex-start;
    }
    .nav-container {
      flex-direction: column;
      align-items: stretch;
      padding: 0;
    }
    .nav-links {
      width: 100%;
      padding: 0 12px;
    }
    .nav-cta-wrap {
      display: none;
    }
  }
</style>
